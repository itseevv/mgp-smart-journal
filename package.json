{
  "name": "journal-chip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-preflight.mjs",
    "dev": "next dev --webpack",
    "dev:stable": "npm run dev",
    "predev:turbo": "JOURNAL_CHIP_DEV_MODE=turbo node scripts/dev-preflight.mjs",
    "dev:turbo": "JOURNAL_CHIP_ALLOW_TURBO=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "qa:journal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa-journal-route.mjs",
    "qa:journal:smoke": "JOURNAL_QA_SMOKE=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa-journal-route.mjs",
    "qa:journal:mobile": "node scripts/qa-journal-mobile-browser.mjs",
    "qa:journal:mobile:smoke": "JOURNAL_QA_SMOKE=1 node scripts/qa-journal-mobile-browser.mjs",
    "qa:monthly-export": "node scripts/qa-monthly-export-browser.mjs",
    "qa:monthly-export:authenticated": "node scripts/qa-monthly-export-authenticated.mjs",
    "seed:capsule": "node scripts/seed-capsule.mjs",
    "seed:batch": "node scripts/seed-admin-batch.mjs",
    "issue:recovery": "node scripts/issue-recovery-code.mjs"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.108.1",
    "@twemoji/api": "https://github.com/jdecked/twemoji/archive/refs/tags/v17.0.3.tar.gz",
    "@twemoji/parser": "17.0.2",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
