NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Edge Function / local seed environments only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=

# Server-side canonical origin for Admin-generated capsule URLs, NFC payloads,
# QR codes, and fulfilment CSV exports. Use an ngrok/staging/production URL for
# physical testing; localhost is only for explicit local-only testing.
APP_BASE_URL=http://localhost:3000

# Edge Function secret only. The browser, seed script, and issuance CLI do not use it.
RECOVERY_CODE_PEPPER_V1=generate-a-long-random-secret

# Internal Admin MVP. Server-side only; never expose as NEXT_PUBLIC_*.
ADMIN_PASSCODE=choose-a-strong-internal-passcode
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
